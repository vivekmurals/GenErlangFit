test_that("Reported NLL matches manual dgamma log-likelihood", {
fit <- GenErlang_Fit('Erlang', ref_data, pvaloption = 'KS')
k_hat   <- fit$Best$K_star
lam_hat <- fit$Best$Lambda_star
manual_nll <- -sum(dgamma(ref_data, shape = k_hat, rate = 1/lam_hat, log = TRUE))
expect_equal(fit$Best$Loglikelihood, manual_nll, tolerance = 1e-4)
})
# ---------------------------------------------------------
# Test 6: Known edge case — heavily tied/discrete data inflates KS
#          relative to CvM/AD (documents known limitation, doesn't "fail")
# ---------------------------------------------------------
test_that("KS is more sensitive than CvM/AD under heavy ties (documented behavior)", {
tied_data <- c(4,3,11,4,4,7,5,5,11,6,4,11,4,4,5,5,5,10,1,5,
10,4,8,9,6,8,2,2,12,5,7,6,3,4,8,5,4,3,3,4)
fit_ks  <- GenErlang_Fit('Erlang', tied_data, pvaloption = 'KS')
fit_cvm <- GenErlang_Fit('Erlang', tied_data, pvaloption = 'CVM')
fit_ad  <- GenErlang_Fit('Erlang', tied_data, pvaloption = 'AD')
# Not a strict correctness assertion -- documents known statistical behavior
expect_true(fit_ks$Best$P_star <= fit_cvm$Best$P_star)
expect_true(fit_ks$Best$P_star <= fit_ad$Best$P_star)
})
# ---------------------------------------------------------
# Test 7: Negative log-likelihood matches manual dgamma computation
# ---------------------------------------------------------
test_that("Reported NLL matches manual dgamma log-likelihood", {
fit <- GenErlang_Fit('Erlang', ref_data, pvaloption = 'KS')
k_hat   <- fit$Best$K_star
lam_hat <- fit$Best$Lambda_star
manual_nll <- -sum(dgamma(ref_data, shape = k_hat, rate = lam_hat, log = TRUE))
expect_equal(fit$Best$Loglikelihood, manual_nll, tolerance = 1e-4)
})
